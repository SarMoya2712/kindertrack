# Required. PostgreSQL is the only supported application database.
# postgresql:// is also accepted and uses the installed psycopg 3 driver.
# Replace these placeholders; URL-encode special characters in credentials.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/kindscan
# Separate disposable PostgreSQL database; required for integration tests.
TEST_DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/kindscan_test
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# When empty, the existing private instance/session.key is reused.
SECRET_KEY=
TIMEZONE=Asia/Tashkent
# HTTP-only and SameSite=Lax are always enabled; sessions expire after 8 hours.
# Logout revokes the session in PostgreSQL.
# false only for localhost HTTP development; true for production HTTPS.
COOKIE_SECURE=true
# Minimum cosine similarity for stored SFace vectors (not a probability).
# Higher values reject more uncertain matches; restart after changes.
FACE_THRESHOLD=0.50
# Minimum gap between the best two different children.
FACE_MARGIN=0.08
# true blocks scanning until a real LivenessProvider is installed.
REQUIRE_LIVENESS=false

# Optional comma-separated production hosts, e.g. attendance.example.org
TRUSTED_HOSTS=

# Continuous scanner (values are bounded to mobile-friendly ranges).
LIVE_SCAN_INTERVAL_MS=600
LIVE_SCAN_STABLE_FRAMES=3
LIVE_SCAN_WINDOW_SECONDS=5
LIVE_SCAN_PAUSE_MS=2500
LIVE_UNKNOWN_COOLDOWN_SECONDS=60
LIVE_UNKNOWN_SIMILARITY=0.65

# Persistent private files. On Railway attach a volume, e.g. /data.
# Defaults on Railway: DATA_DIR=$RAILWAY_VOLUME_MOUNT_PATH; MODEL_DIR=$DATA_DIR/models.
# DATA_DIR=/data
# MODEL_DIR=/data/models
